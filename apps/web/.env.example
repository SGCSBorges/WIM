# Base URL of the WIM API (no trailing slash).
# Local dev (default API on port 3000):
VITE_API_BASE_URL=http://localhost:3000/api

# Production (Render):
# VITE_API_BASE_URL=https://wimapi.onrender.com/api

# Feature flags (optional):
# Set to "0" to hide the barcode scanner even where the browser supports it.
# VITE_FEATURE_BARCODE=1
# Set to "1" to enrich scanned barcodes with name/image via Open Food Facts.
# VITE_FEATURE_BARCODE_LOOKUP=1
