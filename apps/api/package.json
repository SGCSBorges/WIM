{
  "name": "@wim/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:deploy:retry": "ts-node src/scripts/prisma-migrate-deploy-retry.ts",
    "db:lock": "ts-node src/scripts/db-check-advisory-lock.ts",
    "promote:admin": "ts-node src/scripts/promote-to-admin.ts",
    "render-build": "npm run prisma:generate && npm run prisma:deploy:retry && npm run build",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "lint": "eslint \"src/**/*.{js,ts}\"",
    "typecheck": "tsc --noEmit",
    "seed:dev": "ts-node src/scripts/generate-test-data.ts",
    "smoke:alerts": "ts-node src/scripts/smoke-alerts.ts",
    "prune:audit": "ts-node src/scripts/prune-audit-log.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/__tests__/integration",
    "worker": "node dist/jobs/workers.js"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^1.4.13",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "@wim/types": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "otplib": "^12.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^11.3.0",
    "qrcode": "^1.5.4",
    "stripe": "^17.6.0",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.1",
    "zod-openapi": "^5.4.6"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/pino": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.0.3",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
