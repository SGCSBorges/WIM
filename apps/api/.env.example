# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wim?schema=public"

# API
PORT=3000
NODE_ENV=development

# JWT — REQUIRED in production; app will refuse to start without this
JWT_SECRET="change-me-to-a-long-random-secret"

# CORS — comma-separated origins allowed in production
# Leave blank in development to allow all origins
CORS_ORIGIN="https://your-frontend.example.com"

# App URL (used to build callback URLs, e.g. Stripe redirect)
APP_URL="http://localhost:5173"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_POWER_USER_PRICE_MONTHLY="price_..."
STRIPE_POWER_USER_PRICE_YEARLY="price_..."

# Stripe webhook replay-window. Events older than this many seconds are
# acknowledged with 200 but skipped (defense against payload replay where the
# signature alone doesn't bound age). Default 300 (5 min).
STRIPE_WEBHOOK_MAX_AGE_SEC="300"

# Rate limits — all numeric envs are validated at boot; an invalid value
# warns and falls back to the default.
# Global per-IP limiter (applied to every /api/* route).
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="100"
# Tighter bucket on auth endpoints (login/register/forgot/reset/logout) to
# slow brute-force attempts. 15-min window, default 20 attempts/IP.
AUTH_RATE_LIMIT_MAX="20"
# Per-resource creation bucket on POST /api/tags and POST /api/locations so
# a script can't bloat the DB with spam rows. 5-min window, default 40.
CREATE_RATE_LIMIT_MAX="40"

# Redis (BullMQ job queue)
# Preferred: a single REDIS_URL (used everywhere if set).
REDIS_URL="redis://localhost:6379"
# Fallback used ONLY when REDIS_URL is unset — e.g. local dev or a Render
# instance with separate host/port env. In production prefer REDIS_URL.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
# Set to "true" if your Redis instance requires TLS (e.g. Upstash production)
REDIS_TLS="false"
# Set to "false" to disable background jobs entirely (useful in review / staging envs)
JOBS_ENABLED="true"

# Audit-log retention. The maintenance worker prunes AuditLog rows older than
# this many days, once a day at 03:00 UTC. 0 = retain forever (schedule
# skipped). Defaults to 90.
AUDIT_RETENTION_DAYS="90"

# Soft-deleted articles retention. Trashed rows older than this many days are
# permanently purged once a day at 03:30 UTC. 0 = retain forever (schedule
# skipped). Defaults to 30.
ARTICLE_TRASH_RETENTION_DAYS="30"

# Weekly warranty digest (Mondays 09:00 UTC). Per-user opt-in via the
# Profile toggle is gated by User.weeklyDigest in the DB; this env is a
# deploy-level kill-switch. Default "true". Set "false" to skip scheduling
# the repeatable job entirely (e.g. review/staging envs).
WARRANTY_DIGEST_ENABLED="true"

# VAPID (web push notifications — optional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Email reminders via Resend (optional). When both are set, reminders are also
# emailed (respecting each user's emailReminders opt-out). Unset = no-op.
# MAIL_FROM must be a Resend-verified sender, e.g. "WIM <reminders@yourdomain.com>".
RESEND_API_KEY=""
MAIL_FROM=""
