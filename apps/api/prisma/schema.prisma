// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  POWER_USER
  ADMIN
}

enum SharePermission {
  READ
  WRITE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AttachmentType {
  INVOICE
  WARRANTY
  OTHER
}

enum AlerteStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum AlerteKind {
  WARRANTY
  CUSTOM
}

enum ClaimStatus {
  NONE
  OPEN
  APPROVED
  REJECTED
  RESOLVED
}

enum ArticleNoteKind {
  SERVICE
  WARRANTY_CLAIM
  MAINTENANCE
  OTHER
}

model Location {
  locationId  Int      @id @default(autoincrement())
  ownerUserId Int
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User              @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)
  articles ArticleLocation[]

  @@index([ownerUserId])
  @@unique([ownerUserId, name], map: "uq_location_owner_name")
}

model User {
  userId    Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(USER)

  // Bumped on admin "force-logout": existing JWTs carry the version they
  // were issued with; auth middleware rejects any token whose version is
  // older than the current value.
  tokenVersion Int   @default(0)

  // Billing (Stripe)
  // Used to manage subscription lifecycle (cancel at period end, etc.)
  stripeCustomerId     String? @unique @db.VarChar(80)
  stripeSubscriptionId String? @unique @db.VarChar(80)

  // Display currency (ISO 4217) for inventory value formatting on the client.
  currency String @default("USD") @db.VarChar(3)

  // Capability token for the read-only iCalendar feed (calendar apps can't
  // send the auth cookie). Null = feed disabled.
  calendarToken String? @unique @db.VarChar(64)

  // Opt-out switch for emailed reminders (push is governed separately by
  // having a subscription). Defaults on; the Profile page can disable it.
  emailReminders Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inventaire possédé
  articlesOwned   Article[]   @relation("UserArticles")
  warrantiesOwned Garantie[]  @relation("UserWarranties")
  alertsOwned     Alerte[]    @relation("UserAlerts")

  // Partage
  shareInvites ShareInvite[] @relation("UserShareInvites") // owner (créateur)
  sharesGiven  InventoryShare[] @relation("SharesGiven")   // owner -> target
  sharesReceived InventoryShare[] @relation("SharesReceived") // target -> owner

  // Audit (optionnel)
  auditLogs AuditLog[]
  attachments Attachment[]
  locations   Location[]
  tags        Tag[]
  articleNotes ArticleNote[]
  savedViews  SavedView[]
  pushSubscriptions PushSubscription[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  // SHA-256 hex of the plaintext token we email out. The plaintext never
  // hits the DB, so a stolen dump can't be used to consume an unused token.
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
}

model Article {
  articleId          Int      @id @default(autoincrement())
  ownerUserId        Int
  articleNom         String   @db.VarChar(100)
  articleModele      String   @db.VarChar(100)
  articleDescription String?  @db.VarChar(255)
  productImageUrl    String?  @db.VarChar(500)

  // Identity fields for power-user lookups ("find my laptop by serial").
  // Folded into the substring `q` filter alongside name/model/description.
  serialNumber       String?  @db.VarChar(120)
  brand              String?  @db.VarChar(120)

  // Purchase price for inventory-value tracking. Decimal to avoid float
  // rounding; serialized as a string over JSON and formatted on the client.
  purchasePrice      Decimal? @db.Decimal(12, 2)

  // Annual straight-line depreciation rate as a percentage (0–100). Null
  // means the item doesn't depreciate. Used to derive a current value from
  // purchasePrice and the item's age.
  depreciationRate   Decimal? @db.Decimal(5, 2)

  // Sharing v2 (simplest): when true, this article is visible in the shared view
  // to all POWER_USER accounts (read-only; owner-only edit/unshare).
  sharedWithPowerUsers Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Soft-delete marker. Null = live. Live reads scope `deletedAt: null`; the
  // Trash view lists rows where this is set. A daily maintenance job
  // hard-deletes rows older than ARTICLE_TRASH_RETENTION_DAYS.
  deletedAt DateTime?

  owner    User     @relation("UserArticles", fields: [ownerUserId], references: [userId], onDelete: Cascade)
  garantie Garantie?
  attachments Attachment[]
  alertes  Alerte[]
  locations ArticleLocation[]
  tags     ArticleTag[]
  notes    ArticleNote[]

  @@index([ownerUserId])
  @@index([ownerUserId, deletedAt])
  @@index([articleNom, articleModele])
  @@index([sharedWithPowerUsers])
  @@index([sharedWithPowerUsers, updatedAt(sort: Desc)])
  // Trigram GIN indexes accelerate the substring ILIKE search (see
  // article.service buildArticleWhere). Requires the pg_trgm extension,
  // created in the same migration.
  @@index([articleNom(ops: raw("gin_trgm_ops"))], type: Gin, map: "Article_articleNom_trgm_idx")
  @@index([articleModele(ops: raw("gin_trgm_ops"))], type: Gin, map: "Article_articleModele_trgm_idx")
  @@index([articleDescription(ops: raw("gin_trgm_ops"))], type: Gin, map: "Article_articleDescription_trgm_idx")
  // serialNumber + brand joined the `q` substring OR in round 8 (F1) but had
  // no trigram index, so those terms fell back to a sequential scan.
  @@index([serialNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "Article_serialNumber_trgm_idx")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "Article_brand_trgm_idx")
}

model Tag {
  tagId       Int      @id @default(autoincrement())
  ownerUserId Int
  name        String   @db.VarChar(40)
  createdAt   DateTime @default(now())

  owner    User         @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)
  articles ArticleTag[]

  @@unique([ownerUserId, name], map: "uq_tag_owner_name")
  @@index([ownerUserId])
}

model ArticleTag {
  articleId Int
  tagId     Int

  article Article @relation(fields: [articleId], references: [articleId], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [tagId], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model ArticleNote {
  noteId      Int             @id @default(autoincrement())
  articleId   Int
  ownerUserId Int
  content     String          @db.VarChar(2000)
  // Categorize the entry (service log, claim event, maintenance, generic
  // observation) so the timeline can be filtered. Defaults to OTHER so the
  // backfill of existing rows stays neutral.
  kind        ArticleNoteKind @default(OTHER)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  article Article @relation(fields: [articleId], references: [articleId], onDelete: Cascade)
  owner   User    @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)

  @@index([articleId])
  @@index([ownerUserId])
}

model SavedView {
  id          Int      @id @default(autoincrement())
  ownerUserId Int
  name        String   @db.VarChar(60)
  // The Articles-page filter querystring (e.g. "warranty=expired&priceMin=100").
  query       String   @db.VarChar(500)
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)

  @@unique([ownerUserId, name], map: "uq_savedview_owner_name")
  @@index([ownerUserId])
}

model ArticleLocation {
  articleId   Int
  locationId  Int
  assignedAt  DateTime @default(now())

  article   Article   @relation(fields: [articleId], references: [articleId], onDelete: Cascade)
  location  Location  @relation(fields: [locationId], references: [locationId], onDelete: Cascade)

  @@id([articleId, locationId])
  @@index([locationId])
}

model Garantie {
  garantieId        Int      @id @default(autoincrement())
  ownerUserId       Int
  // Optional link to an article (0..1). Enforced unique so an article
  // cannot have multiple warranties.
  garantieArticleId Int?     @unique
  garantieNom       String   @db.VarChar(100)
  garantieDateAchat DateTime
  garantieDuration  Int      // en mois
  garantieFin       DateTime
  garantieIsValide  Boolean  @default(true)

  // Optional linked image/proof attachment
  garantieImageAttachmentId Int? @unique

  // Warranty claim workflow: NONE until the owner opens a claim, then tracks
  // its outcome. claimNote is free text; claimUpdatedAt stamps the last change.
  claimStatus    ClaimStatus @default(NONE)
  claimNote      String?     @db.VarChar(2000)
  claimUpdatedAt DateTime?

  // Provider contact details — surfaced on the claim PDF and as a
  // "Contact provider" block in the UI so the owner knows who to call.
  providerName  String? @db.VarChar(120)
  providerPhone String? @db.VarChar(40)
  providerUrl   String? @db.VarChar(2048)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User      @relation("UserWarranties", fields: [ownerUserId], references: [userId], onDelete: Cascade)
  article    Article?  @relation(fields: [garantieArticleId], references: [articleId], onDelete: Cascade)
  garantieImageAttachment Attachment? @relation("GarantieImageAttachment", fields: [garantieImageAttachmentId], references: [attachmentId], onDelete: SetNull)
  attachments Attachment[] @relation("AttachmentGarantie")
  alertes    Alerte[]

  @@index([ownerUserId])
  @@index([garantieFin])
  @@index([ownerUserId, garantieFin])
}

model Alerte {
  alerteId          Int      @id @default(autoincrement())
  ownerUserId       Int
  alerteNom         String   @db.VarChar(100)
  alerteDate        DateTime
  alerteDescription String?  @db.VarChar(255)

  status            AlerteStatus @default(SCHEDULED)
  kind              AlerteKind   @default(WARRANTY)
  // For CUSTOM alerts: repeat every N months after firing (null = one-shot).
  recurrenceMonths  Int?
  // Set when an alert has been snoozed; alerteDate is moved to this time too.
  snoozedUntil      DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?  @db.VarChar(500)
  errorStack        String?  @db.Text

  // Liens (au moins un des deux)
  alerteGarantieId Int?
  alerteArticleId  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User     @relation("UserAlerts", fields: [ownerUserId], references: [userId], onDelete: Cascade)
  garantie Garantie? @relation(fields: [alerteGarantieId], references: [garantieId], onDelete: Cascade)
  article  Article?  @relation(fields: [alerteArticleId], references: [articleId], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([status])
  @@index([ownerUserId, status])
  @@index([alerteDate])
  @@index([ownerUserId, alerteDate])
  @@index([alerteGarantieId])
  @@index([alerteArticleId])

  @@unique([alerteGarantieId, alerteDate], map: "uq_alerte_garantie_date")
}

model Attachment {
  attachmentId Int            @id @default(autoincrement())
  ownerUserId  Int
  type         AttachmentType @default(INVOICE)

  // Optional links to related entities
  articleId  Int?
  garantieId Int?

  // Stockage (S3/Cloud) -> URL, ou stockage DB -> base64 (déconseillé)
  fileName     String         @db.VarChar(255)
  mimeType     String         @db.VarChar(100)
  fileSize     Int
  fileUrl      String         @db.VarChar(500)
  // Resized preview generated for image uploads; null for PDFs or when
  // resizing failed (callers fall back to fileUrl).
  thumbUrl     String?        @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User     @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)
  article  Article? @relation(fields: [articleId], references: [articleId], onDelete: Cascade)
  garantie Garantie? @relation("AttachmentGarantie", fields: [garantieId], references: [garantieId], onDelete: Cascade)
  garantieImageFor Garantie? @relation("GarantieImageAttachment")

  @@index([ownerUserId])
  @@index([articleId])
  @@index([garantieId])
}

model InventoryShare {
  inventoryShareId Int             @id @default(autoincrement())
  ownerUserId      Int
  targetUserId     Int
  permission       SharePermission @default(READ)
  active           Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User @relation("SharesGiven", fields: [ownerUserId], references: [userId], onDelete: Cascade)
  target User @relation("SharesReceived", fields: [targetUserId], references: [userId], onDelete: Cascade)

  @@unique([ownerUserId, targetUserId], map: "uq_share_owner_target")
  @@index([ownerUserId])
  @@index([targetUserId])
}

model ShareInvite {
  shareInviteId Int          @id @default(autoincrement())
  ownerUserId   Int
  email         String       @db.VarChar(255)
  token         String       @unique @db.VarChar(128)
  status        InviteStatus @default(PENDING)
  permission    SharePermission @default(READ)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("UserShareInvites", fields: [ownerUserId], references: [userId], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([email])
  @@index([status])
  // createInvite filters on all three together (owner + email + PENDING); a
  // compound index collapses that to a single seek under concurrent invites.
  @@index([ownerUserId, email, status])
}

// Persistent record of every Stripe webhook event we have already
// processed. The webhook handler tries to insert here first; a unique
// violation on `eventId` is treated as a duplicate delivery and the rest
// of the handler is skipped. This survives application restarts, unlike
// the in-row stripeSubscriptionId no-op guard it complements.
model ProcessedStripeEvent {
  eventId     String   @id @db.VarChar(255)
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now())

  @@index([type])
  @@index([processedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  Int?
  ip        String?  @db.VarChar(80)
  userAgent String?  @db.VarChar(255)
  method    String?  @db.VarChar(20)
  path      String?  @db.VarChar(255)
  status    Int?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [userId], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}
