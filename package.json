{
  "name": "wim",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "echo \"Workspaces ready (install per app in next steps).\"",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "render-build:web": "npm ci --include=optional && npm run build:web",
    "render-build:api": "npm ci --include=optional && npm --workspace apps/api run render-build",
    "lint": "npm run lint --workspaces --if-present",
    "fmt": "npm run format --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "docs:uml": "bash scripts/render-uml.sh"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "qs": "6.15.2"
  }
}
