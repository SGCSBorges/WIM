@startuml
title WIM – Diagramme de classes

skinparam class {
  BackgroundColor #ffffff
  ArrowColor #555555
  BorderColor #555555
}
skinparam noteBackgroundColor #F5F7FF
skinparam noteBorderColor #6B7280
hide circle

enum Role {
  USER
  POWER_USER
  ADMIN
}

class User {
  +userId: int
  +email: string
  +role: Role
  +tokenVersion: int
  +currency: char(3)
  +emailReminders: bool
  +weeklyDigest: bool
  +warrantyReminderDays: varchar(40)  ' CSV, null = J-30/7/1
  +emailVerifiedAt: datetime
  +theme: varchar(16)
  +language: varchar(8)
  +dateFormat: varchar(16)
  +calendarToken: varchar(64)
  +alertsSeenAt: datetime
  +totpEnabled: bool
  +stripeCustomerId: string
  +stripeSubscriptionId: string
  +monthlyBudget: decimal(12,2)
  +annualBudget: decimal(12,2)
}

class Article {
  +articleId: int
  +articleNom: varchar(100)
  +articleModele: varchar(100)
  +articleDescription: varchar(255)
  +productImageUrl: varchar(500)
  +serialNumber: varchar(120)
  +brand: varchar(120)
  +purchasedFrom: varchar(150)
  +orderRef: varchar(100)
  +purchasePrice: decimal(12,2)  ' prix UNITAIRE
  +quantity: int  ' valeur = prix × quantité
  +depreciationRate: decimal(5,2)
  +sharedWithPowerUsers: bool
  +publicToken: varchar(64)
  +status: ArticleStatus
  +category: ArticleCategory
  +condition: ArticleCondition
  +bundle: varchar(80)  ' regroupement libre
  +isFavorite: bool
  +lastVerifiedAt: datetime  ' inventaire physique
  +customFields: jsonb  ' paires {key,value}, privé
  +deletedAt: datetime
}

class Garantie {
  +garantieId: int
  +garantieNom: varchar(100)
  +garantieDateAchat: date
  +garantieDuration: int  ' mois
  +garantieFin: date
  +garantieIsValide: bool
  +claimStatus: ClaimStatus
  +claimNote: varchar(2000)
  +claimUpdatedAt: datetime
  +providerName: varchar(120)
  +providerPhone: varchar(40)
  +providerUrl: varchar(2048)
  +renewedAt: datetime
}

class WarrantyHistory {
  +id: int
  +event: WarrantyHistoryEvent
  +priorDateAchat: date
  +priorDuration: int
  +priorFin: date
  +note: varchar(500)
}

class Alerte {
  +alerteId: int
  +alerteNom: varchar(100)
  +alerteDate: date
  +status: AlerteStatus
  +kind: AlerteKind
  +recurrenceMonths: int
  +reminderDays: int  ' décalage du rappel garantie
  +snoozedUntil: datetime
}

class Attachment {
  +attachmentId: int
  +type: AttachmentType
  +fileName: varchar(255)
  +mimeType: varchar(100)
  +fileUrl: varchar(500)
  +thumbUrl: varchar(500)
}

class Location {
  +locationId: int
  +name: varchar(120)
  +description: varchar(255)
  +parentLocationId: int  ' hiérarchie, SetNull
}

class Tag {
  +tagId: int
  +name: varchar(40)
}

class ArticleNote {
  +noteId: int
  +content: varchar(2000)
  +kind: ArticleNoteKind
}

class SavedView {
  +id: int
  +name: varchar(60)
  +query: varchar(500)
  +isDefault: bool  ' au plus une par propriétaire
  +sharedWithHousehold: bool  ' lecture seule pour le foyer
}

class ArticleTemplate {
  +id: int
  +name: varchar(120)
  +payload: jsonb  ' noms (pas d'ids)
}

class InventoryShare {
  +inventoryShareId: int
  +permission: SharePermission
  +active: bool
  +viaHouseholdId: int  ' maillage foyer, SetNull
}

class ShareInvite {
  +shareInviteId: int
  +email: varchar(255)
  +token: varchar(128)
  +status: InviteStatus
  +permission: SharePermission
  +expiresAt: datetime
}

class ArticleTransferRequest {
  +id: int
  +direction: TransferDirection
  +token: varchar(128)
  +status: varchar(20)  ' PENDING|ACCEPTED|REJECTED|REVOKED|EXPIRED
  +message: varchar(500)
  +expiresAt: datetime
}

class AuditLog {
  +id: int
  +action: varchar(80)
  +entity: varchar(80)
  +entityId: int
  +createdAt: datetime
}

' --- Sécurité & infrastructure ---

class UserSession {
  +id: int
  +jti: varchar(64)  ' = claim JWT + clé denylist Redis
  +deviceLabel: varchar(120)
  +lastActiveAt: datetime
  +revokedAt: datetime
}

class TotpSecret {
  +id: int
  +secret: varchar(64)  ' base32
  +backupCodesHash: text  ' bcrypt, usage unique
  +verified: bool
}

class WebAuthnCredential {
  +id: int
  +credentialId: varchar(512)  ' Base64URL, unique
  +publicKey: bytes
  +counter: int  ' anti-clonage, mis à jour à chaque assertion
  +transports: varchar(120)  ' CSV usb/nfc/ble/internal/hybrid
  +deviceLabel: varchar(120)
  +lastUsedAt: datetime
}

class PasswordResetToken {
  +id: int
  +tokenHash: varchar(64)  ' SHA-256, jamais le clair
  +expiresAt: datetime
  +consumedAt: datetime
}

class EmailVerificationToken {
  +id: int
  +tokenHash: varchar(64)  ' SHA-256, jamais le clair
  +expiresAt: datetime
  +consumedAt: datetime
}

class WishlistItem {
  +id: int
  +name: varchar(120)
  +url: varchar(500)
  +targetPrice: decimal(12,2)
  +note: varchar(500)
  +purchasedAt: datetime  ' non nul = acheté
}

class PushSubscription {
  +id: int
  +endpoint: varchar(500)
  +p256dh: varchar(200)
  +auth: varchar(100)
}

class ProcessedStripeEvent {
  +eventId: varchar(255)  ' PK = idempotence webhook
  +type: varchar(100)
  +processedAt: datetime
}

' --- Modules cycle de vie par article (payants) ---

class Loan {
  +loanId: int
  +borrowerName: varchar(120)
  +borrowerEmail: varchar(180)
  +loanedAt: datetime
  +dueAt: datetime
  +returnedAt: datetime
  +reminderAlerteId: int  ' rappel d'échéance
}

class InsurancePolicy {
  +policyId: int
  +provider: varchar(150)
  +policyNumber: varchar(100)
  +premium: decimal(12,2)
  +coverageAmount: decimal(12,2)
  +renewalAt: datetime
  +reminderAlerteId: int  ' rappel de renouvellement
}

class ServiceRecord {
  +serviceId: int
  +performedAt: datetime
  +description: varchar(300)
  +cost: decimal(12,2)
  +provider: varchar(150)
  +nextDueAt: datetime
  +intervalMonths: int  ' cadence récurrente
  +reminderAlerteId: int  ' rappel prochain entretien
}

' --- Messagerie (négociation 1:1 sur un article partagé) ---

class MessageThread {
  +id: int
  +lastMessageAt: datetime
  +ownerUnread: bool
  +requesterUnread: bool
}

class Message {
  +id: int
  +body: varchar(2000)
  +kind: MessageKind
  +offerAmount: decimal(12,2)
  +offerStatus: OfferStatus
}

' --- Foyer (maillage auto-géré de partages WRITE) ---

class Household {
  +id: int
  +name: varchar(120)
  +createdByUserId: int  ' informatif, sans FK
}

class HouseholdMember {
  +id: int
  +role: HouseholdRole  ' OWNER | MEMBER
}

class HouseholdInvite {
  +id: int
  +email: varchar(255)
  +token: varchar(128)
  +status: InviteStatus
  +expiresAt: datetime
}

' --- Feature gating (autonome, configuré par l'admin) ---

class FeatureFlag {
  +featureKey: varchar(60)  ' unique
  +requiredRole: Role
}

class FeatureTempGrant {
  +featureKey: varchar(60)
  +expiresAt: datetime
  +note: varchar(255)
}

' ───────────────────────────────────────────────────────────────
' Composition (losange plein ✱--) = appartenance exclusive avec
' cascade delete : la partie disparaît avec son tout. Le « tout »
' choisi est le parent dont la FK est OBLIGATOIRE (NOT NULL).
' ───────────────────────────────────────────────────────────────

' Entités rattachées au compte (ownerUserId / userId NOT NULL)
User "1" *-- "0..*" Article
User "1" *-- "0..*" Location
User "1" *-- "0..*" Tag
User "1" *-- "0..*" SavedView
User "1" *-- "0..*" ArticleTemplate
User "1" *-- "0..*" ShareInvite
User "1" *-- "0..*" InsurancePolicy
User "1" *-- "0..*" Garantie
User "1" *-- "0..*" Attachment
User "1" *-- "0..*" Alerte
User "1" *-- "0..*" UserSession
User "1" *-- "0..1" TotpSecret
User "1" *-- "0..*" WebAuthnCredential
User "1" *-- "0..*" PasswordResetToken
User "1" *-- "0..*" EmailVerificationToken
User "1" *-- "0..*" PushSubscription
User "1" *-- "0..*" WishlistItem
User "1" *-- "0..1" HouseholdMember
Household "1" *-- "1..*" HouseholdMember
Household "1" *-- "0..*" HouseholdInvite

' Entités qui EXIGENT un article (articleId NOT NULL)
Article "1" *-- "0..*" ArticleNote
Article "1" *-- "0..*" Loan
Article "1" *-- "0..*" ServiceRecord
Article "1" *-- "0..*" MessageThread
Article "1" *-- "0..*" ArticleTransferRequest
Garantie "1" *-- "0..*" WarrantyHistory : append-only
MessageThread "1" *-- "1..*" Message

' ───────────────────────────────────────────────────────────────
' Association (-->) = référence navigable SANS appartenance
' exclusive (FK nullable, ou plusieurs rôles vers le même User).
' ───────────────────────────────────────────────────────────────

' AuditLog : userId onDelete SetNull → SURVIT au user (donc PAS composition)
User "1" --> "0..*" AuditLog : trace

' Liens optionnels (FK nullable) : couverture de garantie / preuves
Garantie "0..1" --> "0..1" Article : couvre (unique)
Attachment "0..*" --> "0..1" Article
Attachment "0..*" --> "0..1" Garantie : preuve / pièces CLAIM
Alerte "0..*" --> "0..1" Garantie : J-30/J-7/J-1
Alerte "0..*" --> "0..1" Article : custom

' Rôles « propriétaire / 2e partie » des entités co-rattachées à un article
User "1" --> "0..*" Loan : prêteur
User "1" --> "0..*" ServiceRecord : propriétaire
User "1" --> "0..*" MessageThread : owner / demandeur
User "1" --> "0..*" Message : expéditeur
User "1" --> "0..*" ArticleTransferRequest : demandeur / owner
User "1" --> "0..*" InventoryShare : owner
User "1" --> "0..*" InventoryShare : target
Household "0..1" --> "0..*" InventoryShare : viaHouseholdId (SetNull)
Location "0..1" --> "0..*" Location : parent (SetNull)

' Relations M:N via tables de jonction (association)
Article "0..*" -- "0..*" Location : ArticleLocation
Article "0..*" -- "0..*" Tag : ArticleTag
Article "0..*" -- "0..*" InsurancePolicy : ArticleInsurance

note bottom
Aligné sur prisma/schema.prisma :
- Notation : composition (✱--) = appartenance exclusive + cascade delete
  (FK obligatoire) ; association (-->) = FK nullable, lien SetNull
  (AuditLog) ou rôle multiple vers User. M:N via table de jonction.
- Une Garantie référence 0..1 Article (garantieArticleId nullable, unique) :
  une garantie autonome est possible (POST /api/warranties), d'où la
  composition sous User et l'association « couvre » vers Article. Le
  renouvellement fait avancer la ligne vivante et archive l'état antérieur
  dans WarrantyHistory (append-only).
- ProcessedStripeEvent, FeatureFlag et FeatureTempGrant sont autonomes
  (pas de FK User) : marqueur d'idempotence du webhook et configuration
  des features par l'admin.
- Modules payants par article : Loan (prêt), InsurancePolicy +
  ArticleInsurance (assurance M:N), ServiceRecord (entretien), chacun
  pouvant planifier un rappel via reminderAlerteId.
- MessageThread = 1 fil par (article, demandeur) ; ownerUserId est figé à
  la création, donc un transfert ultérieur ne casse pas la conversation.
- Les noms français legacy (Alerte*, Garantie, articleNom...) sont
  intentionnellement conservés ; les unions @wim/types sont anglaises
  (AlertStatus) mais les valeurs littérales coïncident.
- Un Household est un maillage auto-géré de lignes InventoryShare en WRITE
  (marquées viaHouseholdId) entre tous ses membres (max 6, un foyer par
  utilisateur) — les surfaces de partage existantes restent inchangées.
- Enums : Role, ClaimStatus, AlerteStatus, AlerteKind, AttachmentType
  (INVOICE/WARRANTY/CLAIM/OTHER), ArticleNoteKind, ArticleStatus,
  ArticleCategory, ArticleCondition, SharePermission, InviteStatus,
  HouseholdRole, TransferDirection, MessageKind, OfferStatus,
  WarrantyHistoryEvent.
- Référence champ-par-champ exhaustive : ../data-dictionary.md.
end note
@enduml
