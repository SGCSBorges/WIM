@startuml
title WIM – Diagramme de classes

skinparam class {
  BackgroundColor #ffffff
  ArrowColor #555555
  BorderColor #555555
}
skinparam noteBackgroundColor #F5F7FF
skinparam noteBorderColor #6B7280
hide circle

enum Role {
  USER
  POWER_USER
  ADMIN
}

class User {
  +userId: int
  +email: string
  +role: Role
  +tokenVersion: int
  +currency: char(3)
  +emailReminders: bool
  +weeklyDigest: bool
  +theme: varchar(16)
  +language: varchar(8)
  +dateFormat: varchar(16)
  +calendarToken: varchar(64)
  +alertsSeenAt: datetime
  +totpEnabled: bool
  +stripeCustomerId: string
  +stripeSubscriptionId: string
  +monthlyBudget: decimal(12,2)
  +annualBudget: decimal(12,2)
}

class Article {
  +articleId: int
  +articleNom: varchar(100)
  +articleModele: varchar(100)
  +articleDescription: varchar(255)
  +productImageUrl: varchar(500)
  +serialNumber: varchar(120)
  +brand: varchar(120)
  +purchasePrice: decimal(12,2)
  +depreciationRate: decimal(5,2)
  +sharedWithPowerUsers: bool
  +publicToken: varchar(64)
  +status: ArticleStatus
  +category: ArticleCategory
  +deletedAt: datetime
}

class Garantie {
  +garantieId: int
  +garantieNom: varchar(100)
  +garantieDateAchat: date
  +garantieDuration: int  ' mois
  +garantieFin: date
  +garantieIsValide: bool
  +claimStatus: ClaimStatus
  +claimNote: varchar(2000)
  +claimUpdatedAt: datetime
  +providerName: varchar(120)
  +providerPhone: varchar(40)
  +providerUrl: varchar(2048)
  +renewedAt: datetime
}

class WarrantyHistory {
  +id: int
  +event: WarrantyHistoryEvent
  +priorDateAchat: date
  +priorDuration: int
  +priorFin: date
  +note: varchar(500)
}

class Alerte {
  +alerteId: int
  +alerteNom: varchar(100)
  +alerteDate: date
  +status: AlerteStatus
  +kind: AlerteKind
  +recurrenceMonths: int
  +snoozedUntil: datetime
}

class Attachment {
  +attachmentId: int
  +type: AttachmentType
  +fileName: varchar(255)
  +mimeType: varchar(100)
  +fileUrl: varchar(500)
  +thumbUrl: varchar(500)
}

class Location {
  +locationId: int
  +name: varchar(120)
  +description: varchar(255)
}

class Tag {
  +tagId: int
  +name: varchar(40)
}

class ArticleNote {
  +noteId: int
  +content: varchar(2000)
  +kind: ArticleNoteKind
}

class SavedView {
  +id: int
  +name: varchar(60)
  +query: varchar(500)
}

class ArticleTemplate {
  +id: int
  +name: varchar(120)
  +payload: jsonb  ' noms (pas d'ids)
}

class InventoryShare {
  +inventoryShareId: int
  +permission: SharePermission
  +active: bool
}

class ShareInvite {
  +shareInviteId: int
  +email: varchar(255)
  +token: varchar(128)
  +status: InviteStatus
  +permission: SharePermission
  +expiresAt: datetime
}

class ArticleTransferRequest {
  +id: int
  +direction: TransferDirection
  +token: varchar(128)
  +status: varchar(20)  ' PENDING|ACCEPTED|REJECTED|REVOKED|EXPIRED
  +message: varchar(500)
  +expiresAt: datetime
}

class AuditLog {
  +id: int
  +action: varchar(80)
  +entity: varchar(80)
  +entityId: int
  +createdAt: datetime
}

' --- Sécurité & infrastructure ---

class UserSession {
  +id: int
  +jti: varchar(64)  ' = claim JWT + clé denylist Redis
  +deviceLabel: varchar(120)
  +lastActiveAt: datetime
  +revokedAt: datetime
}

class TotpSecret {
  +id: int
  +secret: varchar(64)  ' base32
  +backupCodesHash: text  ' bcrypt, usage unique
  +verified: bool
}

class PasswordResetToken {
  +id: int
  +tokenHash: varchar(64)  ' SHA-256, jamais le clair
  +expiresAt: datetime
  +consumedAt: datetime
}

class PushSubscription {
  +id: int
  +endpoint: varchar(500)
  +p256dh: varchar(200)
  +auth: varchar(100)
}

class ProcessedStripeEvent {
  +eventId: varchar(255)  ' PK = idempotence webhook
  +type: varchar(100)
  +processedAt: datetime
}

' --- Modules cycle de vie par article (payants) ---

class Loan {
  +loanId: int
  +borrowerName: varchar(120)
  +borrowerEmail: varchar(180)
  +loanedAt: datetime
  +dueAt: datetime
  +returnedAt: datetime
  +reminderAlerteId: int  ' rappel d'échéance
}

class InsurancePolicy {
  +policyId: int
  +provider: varchar(150)
  +policyNumber: varchar(100)
  +premium: decimal(12,2)
  +coverageAmount: decimal(12,2)
  +renewalAt: datetime
  +reminderAlerteId: int  ' rappel de renouvellement
}

class ServiceRecord {
  +serviceId: int
  +performedAt: datetime
  +description: varchar(300)
  +cost: decimal(12,2)
  +provider: varchar(150)
  +nextDueAt: datetime
  +reminderAlerteId: int  ' rappel prochain entretien
}

' --- Messagerie (négociation 1:1 sur un article partagé) ---

class MessageThread {
  +id: int
  +lastMessageAt: datetime
  +ownerUnread: bool
  +requesterUnread: bool
}

class Message {
  +id: int
  +body: varchar(2000)
  +kind: MessageKind
  +offerAmount: decimal(12,2)
  +offerStatus: OfferStatus
}

' --- Feature gating (autonome, configuré par l'admin) ---

class FeatureFlag {
  +featureKey: varchar(60)  ' unique
  +requiredRole: Role
}

class FeatureTempGrant {
  +featureKey: varchar(60)
  +expiresAt: datetime
  +note: varchar(255)
}

' Possession (tout est rattaché à un User propriétaire)
User "1" --> "0..*" Article : possède
User "1" --> "0..*" Location : possède
User "1" --> "0..*" Tag : possède
User "1" --> "0..*" SavedView : possède
User "1" --> "0..*" ArticleTemplate : possède
User "1" --> "0..*" AuditLog : trace

' Articles et leurs entités liées
Article "1" o-- "0..1" Garantie : possède
Article "1" o-- "0..*" Attachment : pièces
Article "1" o-- "0..*" Alerte : déclenche
Article "1" o-- "0..*" ArticleNote : historique
Garantie "1" o-- "0..3" Alerte : génère (J-30/J-7/J-1)
Garantie "1" o-- "0..*" Attachment : preuves
Garantie "1" o-- "0..*" WarrantyHistory : renouvellements\n(append-only)

' Relations M:N via tables de jonction
Article "0..*" -- "0..*" Location : ArticleLocation
Article "0..*" -- "0..*" Tag : ArticleTag

' Partage entre utilisateurs
User "1" --> "0..*" ShareInvite : émet
User "1" --> "0..*" InventoryShare : partage (owner -> target)

' Transfert de propriété (PUSH par l'owner / PULL par le demandeur)
Article "1" o-- "0..*" ArticleTransferRequest : transferts
User "1" --> "0..*" ArticleTransferRequest : demandeur / owner

' Sécurité du compte
User "1" --> "0..*" UserSession : appareils connectés
User "1" --> "0..1" TotpSecret : 2FA (TOTP)
User "1" --> "0..*" PasswordResetToken : réinitialisations
User "1" --> "0..*" PushSubscription : navigateurs abonnés

' Modules cycle de vie par article (prêt / assurance / entretien)
User "1" --> "0..*" Loan : prête
User "1" --> "0..*" InsurancePolicy : assure
User "1" --> "0..*" ServiceRecord : entretient
Article "1" o-- "0..*" Loan : prêts
Article "1" o-- "0..*" ServiceRecord : entretien
Article "0..*" -- "0..*" InsurancePolicy : ArticleInsurance

' Messagerie (un fil par (article, demandeur) ; messages append-only)
Article "1" o-- "0..*" MessageThread : négociations
User "1" --> "0..*" MessageThread : owner / demandeur
MessageThread "1" o-- "1..*" Message : messages
User "1" --> "0..*" Message : envoie

note bottom
Aligné sur prisma/schema.prisma :
- Une Garantie appartient à 0..1 Article (lien unique) ; le renouvellement
  fait avancer la ligne vivante et archive l'état antérieur dans
  WarrantyHistory (append-only).
- ProcessedStripeEvent, FeatureFlag et FeatureTempGrant sont autonomes
  (pas de FK User) : marqueur d'idempotence du webhook et configuration
  des features par l'admin.
- Modules payants par article : Loan (prêt), InsurancePolicy +
  ArticleInsurance (assurance M:N), ServiceRecord (entretien), chacun
  pouvant planifier un rappel via reminderAlerteId.
- MessageThread = 1 fil par (article, demandeur) ; ownerUserId est figé à
  la création, donc un transfert ultérieur ne casse pas la conversation.
- Les noms français legacy (Alerte*, Garantie, articleNom...) sont
  intentionnellement conservés ; les unions @wim/types sont anglaises
  (AlertStatus) mais les valeurs littérales coïncident.
- Enums : Role, ClaimStatus, AlerteStatus, AlerteKind, AttachmentType,
  ArticleNoteKind, ArticleStatus, ArticleCategory, SharePermission,
  InviteStatus, TransferDirection, MessageKind, OfferStatus,
  WarrantyHistoryEvent.
- Référence champ-par-champ exhaustive : ../data-dictionary.md.
end note
@enduml
